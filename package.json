{
  "name": "trivia-event-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite preview --port 4174",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.funkt-farkert.trivia",
    "productName": "פונקט פארקערט",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "funkt-farkert-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "shortcutName": "פונקט פארקערט",
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/karantina": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "description": "פונקט פארקערט — מערכת טריוויה חיה לשני מסכים",
  "author": "meanochi"
}
